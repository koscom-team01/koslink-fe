# Koslink Frontend Production Environment Configuration Example
# 백엔드 API 서버의 기본 URL입니다.
# 설정 시 MSW(Mocking)가 꺼지고 해당 백엔드 서버로 실제 HTTP 요청이 전송됩니다.

# 예시 1: 백엔드 API 도메인을 직접 지정하는 경우
VITE_API_BASE_URL=http://koslink-api.hwangonjang.com

# 예시 2: Nginx 역방향 프록시(/api/)를 거치는 경우 (상대 경로)
# VITE_API_BASE_URL=/api
